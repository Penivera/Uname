# Copy to .env.local to override. Only public values belong here: everything is shipped to the browser.
# With no .env.local the app uses the mainnet deployment and the hosted resolver, as below.

VITE_API_URL=https://api.unamereg.xyz
VITE_CONTRACT_ID=uname-registry.near
VITE_NEAR_NETWORK=mainnet
VITE_NEAR_RPC_URL=https://rpc.mainnet.near.org
VITE_NAME_SUFFIX=.uni

# Testnet contract with a resolver running locally (see resolver-py):
# VITE_API_URL=http://localhost:8000
# VITE_CONTRACT_ID=unam-registry.testnet
# VITE_NEAR_NETWORK=testnet
# VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
