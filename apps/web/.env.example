# Copy to .env.local. Only public values belong here: everything is shipped to the browser.

# Production Resolver API (hosted at https://api.unamereg.xyz)
VITE_API_URL=https://api.unamereg.xyz

# Registry contract on NEAR Mainnet
VITE_CONTRACT_ID=uname-registry.near
VITE_NEAR_NETWORK=mainnet
VITE_NEAR_RPC_URL=https://rpc.mainnet.near.org
VITE_NAME_SUFFIX=.uni

# Accounts shown the "claim as contract admin" button (comma-separated). The contract's
# relayer is added automatically. The contract refuses free claims from anyone else anyway.
VITE_ADMIN_ACCOUNTS=bernarditoro.near

# To use testnet or local resolver instead:
# VITE_API_URL=http://localhost:8000
# VITE_CONTRACT_ID=unam-registry.testnet
# VITE_NEAR_NETWORK=testnet
# VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
